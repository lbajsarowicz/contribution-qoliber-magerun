{
  "name": "qoliber/magerun",
  "version": "1.0.5",
  "source": {
    "type": "git",
    "url": "git@bitbucket.org:qoliber/magerun.git",
    "reference": "master"
  },
  "authors": [
    {
      "name": "qoliber",
      "email": "contact@qoliber.com"
    }
  ],
  "license": "OSL-3.0",
  "type": "magento2-component",
  "autoload": {
    "psr-4": {
      "Qoliber\\Magerun\\": "src/"
    }
  },
  "require": {
    "php": ">=7.4",
    "magento/magento-composer-installer": "*"
  },
  "extra": {
    "map": [
      [
        "*",
        "lib/n98-magerun2/modules/qoliber-magerun"
      ]
    ]
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
